FLASK_APP=app.py
FLASK_DEBUG=1

# Leave DATABASE_URL blank to use the DB_* MySQL settings below.
# For local SQLite instead, set DATABASE_URL=sqlite:///wandershare.db
DATABASE_URL=

# AWS RDS for MySQL
DB_HOST=database-1.cvkcs4q28uf5.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=admin
DB_USER=admin
DB_PASSWORD=omj31312

# Recommended: path to the downloaded AWS RDS global CA bundle.
# Leave blank only for an initial non-TLS connectivity test.
DB_SSL_CA=
AUTO_CREATE_DB=1

# auto: S3 configured ho to S3, warna local upload folder.
# local: always local. s3: always S3.
STORAGE_BACKEND=auto
LOCAL_UPLOAD_FOLDER=


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=

# Optional: CloudFront/custom public base URL. If blank, signed URLs are generated.
S3_PUBLIC_BASE_URL=
S3_SIGNED_URL_TTL=3600

# Optional for Cloudflare R2, MinIO, DigitalOcean Spaces, etc.
S3_ENDPOINT_URL=
MAX_UPLOAD_MB=50
